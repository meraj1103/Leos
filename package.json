{
  "name": "leos",
  "version": "1.0.0",
  "type": "module",
  "description": "The Universal, Privacy-First AI Cockpit",
  "main": "electron/main.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:win": "vite build && electron-builder --win nsis",
    "preview": "vite preview"
  },
  "keywords": [
    "ai",
    "cockpit",
    "gemini",
    "chatgpt",
    "claude",
    "ollama",
    "mcp",
    "local-first",
    "privacy"
  ],
  "author": "Leos Contributors",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.leos.cockpit",
    "productName": "Leos",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo.svg"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Leos"
    }
  }
}
